# ─── Database (Supabase → Connect → Transaction pooler, port 6543) ───
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ─── Supabase Auth (Project Settings → API Keys) ───
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only: used to create the demo account

# ─── AI (optional: without it the app runs with clearly-labelled offline templates) ───
ANTHROPIC_API_KEY=
AI_MODEL_SMART=claude-sonnet-5            # research, reality check, plan
AI_MODEL_FAST=claude-haiku-4-5-20251001   # clarifying questions, coach, reviews, weekly extension
AI_DAILY_CALL_CAP=500                     # global safety cap on AI calls per 24h

# ─── Secrets ───
CRON_SECRET=                        # Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
AUTH_SECRET=                        # only used by local-dev auth (no Supabase)
DEMO_EMAIL=demo@aimtrack.app
DEMO_PASSWORD=
